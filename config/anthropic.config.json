{
  "version": 1,
  "modules": [
    {
      "use": "../src/modules/provider-anthropic",
      "config": {
        "model": "anthropic/claude-sonnet-4-5",
        "logRaw": false
      }
    },
    { "use": "../src/modules/tools-read" },
    { "use": "../src/modules/shell" }
  ],
  "models": { "default": "anthropic/claude-sonnet-4-5" },
  "restore": "none",
  "context": { "overflowRatio": 0.8 },
  "shell": {
    "mode": "whitelist",
    "allow": ["ls", "cat", "git", "bun", "wc", "head"]
  },
  "jobs": {
    "defaultTimeoutMs": 300000,
    "maxTimeoutMs": 900000,
    "maxConcurrentPerSession": 8,
    "autoWake": false,
    "maxAutoWakeStreak": 10,
    "maxSummaryChars": 200,
    "maxNotificationChars": 2000,
    "resultTtlDays": 30
  },
  "log": { "level": "info" },
  "dataDir": "../data",
  "prompt": {
    "system": "あなたはツールを使えるアシスタントです。非同期ジョブの結果は通知と read_result で取得してください。"
  },
  "secrets": {
    "ANTHROPIC_API_KEY": { "env": "ANTHROPIC_API_KEY" }
  }
}
