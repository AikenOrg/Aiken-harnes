{
  "version": 1,
  "modules": [
    {
      "use": "../src/modules/provider-openai",
      "config": {
        "model": "gpt-4.1"
      }
    },
    {
      "use": "../src/modules/sqlite",
      "config": {
        "path": "../data/harness.sqlite"
      }
    },
    "../src/modules/tools-fs",
    {
      "use": "../src/modules/shell",
      "config": {}
    },
    "../src/modules/ui-tui"
  ],
  "models": {
    "default": "openai/gpt-4.1"
  },
  "restore": "none",
  "context": {
    "overflowRatio": 0.8
  },
  "shell": {
    "mode": "whitelist",
    "allow": [
      "ls",
      "git",
      "bun"
    ]
  },
  "jobs": {
    "defaultTimeoutMs": 300000,
    "maxTimeoutMs": 900000,
    "maxConcurrentPerSession": 8,
    "autoWake": false,
    "maxAutoWakeStreak": 10,
    "maxSummaryChars": 200,
    "maxNotificationChars": 2000,
    "resultTtlDays": 30
  },
  "log": {
    "level": "info"
  },
  "dataDir": "../data",
  "prompt": {
    "system": "あなたはツールを使えるアシスタントです。非同期ジョブの結果は通知と read_result で取得してください。"
  },
  "secrets": {
    "OPENAI_API_KEY": {
      "env": "OPENAI_API_KEY"
    }
  }
}
