{
  "version": 1,
  "modules": [
    {
      "use": "../src/modules/provider-openai/index.ts",
      "config": { "model": "gpt-4.1" }
    },
    {
      "use": "../src/modules/sqlite/index.ts",
      "config": { "path": "../data/harness.sqlite" }
    },
    "../src/modules/tools-fs/index.ts",
    {
      "use": "../src/modules/shell/index.ts",
      "config": {}
    },
    "../src/modules/ui-tui/index.ts"
  ],
  "models": {
    "default": "openai/gpt-4.1"
  },
  "shell": {
    "mode": "whitelist",
    "allow": ["ls", "git", "bun"]
  },
  "jobs": {
    "defaultTimeoutMs": 300000,
    "maxTimeoutMs": 900000,
    "maxConcurrentPerSession": 4,
    "autoWake": false
  },
  "log": {
    "level": "info"
  },
  "dataDir": "../data",
  "prompt": {
    "system": "あなたはツールを使えるアシスタントです。非同期ジョブの結果は通知と read_result で取得してください。"
  },
  "secrets": {
    "OPENAI_API_KEY": { "env": "OPENAI_API_KEY" }
  }
}
